{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "flutter",
            "request": "launch",
            "name": "Flutter Web (Chrome)",
            "args": ["-d", "chrome"],
            "flutterMode": "debug"
        },
        {
            "type": "flutter",
            "request": "launch",
            "name": "Flutter Web (Release -> build/web)",
            "args": ["-d", "chrome", "--dart-define=FLUTTER_WEB_USE_SKIA=false"],
            "flutterMode": "release"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
